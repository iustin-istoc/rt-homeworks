olor=#222222;" vertex="1" parent="1"><mxGeometry x="515.0" y="929.0" width="257.4" height="26" as="geometry"/></mxCell><mxCell id="c106" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1F5FBF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="962.0" as="sourcePoint"/><mxPoint x="900.0" y="920.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c107" value="eliberare periodică" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="925.0" y="929.0" width="148.2" height="26" as="geometry"/></mxCell><mxCell id="c108" value="" style="html=1;endArrow=block;endFill=0;strokeColor=#1F5FBF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55.0" y="1020.0" as="sourcePoint"/><mxPoint x="55.0" y="978.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c109" value="eveniment acceptat → eliberare" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="105.0" y="987.0" width="234.0" height="26" as="geometry"/></mxCell><mxCell id="c110" value="" style="html=1;endArrow=none;strokeColor=#C62828;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465.0" y="1020.0" as="sourcePoint"/><mxPoint x="465.0" y="990.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c111" value="✕" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450.0" y="964.0" width="30.0" height="36" as="geometry"/></mxCell><mxCell id="c112" value="eveniment respins" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="515.0" y="987.0" width="132.6" height="26" as="geometry"/></mxCell><mxCell id="c113" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="978.0" as="sourcePoint"/><mxPoint x="900.0" y="1020.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c114" value="termen-limită absolut d = r + D" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="925.0" y="987.0" width="241.8" height="26" as="geometry"/></mxCell><mxCell id="c115" value="Ce se vede în diagramă" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="1045.0" width="198.0" height="30" as="geometry"/></mxCell><mxCell id="c116" value="• τ1 este eliberat pe grilă (așteptare absolută); depășirile de prag la t = 2, 4, 7 pun câte un eveniment în coada τ2." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20.0" y="1077.0" width="920.4" height="26" as="geometry"/></mxCell><mxCell id="c117" value="• τ2: evenimentul de la 4.05 este respins (doar 2 s de la eliberarea precedentă); cel de la 7.05 este acceptat. R = 0.2 ≤ D = 0.5." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20.0" y="1103.0" width="1014.0" height="26" as="geometry"/></mxCell><mxCell id="c118" value="• τ3 sosește la 5.95, este preemptat de τ1 la t = 6 (Ready până la 6.1) și termină la 6.2." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20.0" y="1129.0" width="702.0" height="26" as="geometry"/></mxCell><mxCell id="c119" value="• SET_INTERVAL are efect de la jobul următor celui care rula: r₇ = 7 (calculat cu T = 1), apoi r₈ = 9 (T = 2)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20.0" y="1155.0" width="858.0" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
